{
  "name": "01 - Agendamento de Faxina",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "agendamento-faxina",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "11111111-1111-4111-8111-111111111111",
      "name": "Webhook - Novo Agendamento",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-480, 0],
      "webhookId": "agendamento-faxina"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Recebe o corpo enviado pelo formulario da cliente\nconst src = $input.first().json;\nlet b = (src && src.body !== undefined) ? src.body : src;\nif (typeof b === 'string') { try { b = JSON.parse(b); } catch (e) { b = {}; } }\n\nconst nome = b.nome || b.name || 'Cliente';\nconst endereco = b.endereco || b.address || '';\nconst contato = b.contato || b.contact || '';\nconst dataBruta = String(b.data || b.date || '').substring(0, 10);\n\nconst [ano, mes, dia] = dataBruta.split('-').map(Number);\nif (!ano || !mes || !dia) {\n  throw new Error('Data invalida. Envie no formato YYYY-MM-DD.');\n}\n\nconst pad = (n) => String(n).padStart(2, '0');\n// Bloco padrao de 4h (08:00 - 12:00) no fuso de Brasilia (-03:00)\nconst inicioISO = `${ano}-${pad(mes)}-${pad(dia)}T08:00:00-03:00`;\nconst fimISO = `${ano}-${pad(mes)}-${pad(dia)}T12:00:00-03:00`;\n\nconst dataObj = new Date(Date.UTC(ano, mes - 1, dia));\nconst dataFormatada = dataObj.toLocaleDateString('pt-BR', {\n  weekday: 'long', day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC'\n});\n\nconst texto = `📅 Novo Agendamento de Faxina!\n👤 Cliente: ${nome}\n📆 Data: ${dataFormatada}\n📍 Endereço: ${endereco}`;\n\nreturn [{ json: { nome, endereco, contato, dataBruta, dataFormatada, inicioISO, fimISO, texto } }];"
      },
      "id": "22222222-2222-4222-8222-222222222222",
      "name": "Preparar Dados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-240, 0]
    },
    {
      "parameters": {
        "operation": "create",
        "calendar": {
          "__rl": true,
          "value": "SEU_CALENDAR_ID@group.calendar.google.com",
          "mode": "id"
        },
        "start": "={{ $json.inicioISO }}",
        "end": "={{ $json.fimISO }}",
        "additionalFields": {
          "summary": "={{ 'Faxina - ' + $json.nome }}",
          "location": "={{ $json.endereco }}",
          "description": "=Cliente: {{ $json.nome }}\nContato: {{ $json.contato }}\nEndereco: {{ $json.endereco }}"
        }
      },
      "id": "33333333-3333-4333-8333-333333333333",
      "name": "Google Calendar - Criar Evento",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1,
      "position": [20, 0],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "SUBSTITUA_PELA_CREDENCIAL",
          "name": "Google Calendar - Faxinas"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://evolution-api:8080/message/sendText/faxinas",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: '5521970762629', text: $('Preparar Dados').first().json.texto }) }}",
        "options": {}
      },
      "id": "44444444-4444-4444-8444-444444444444",
      "name": "Evolution API - Enviar WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [280, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SUBSTITUA_PELA_CREDENCIAL",
          "name": "Evolution API - apikey"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'ok', mensagem: 'Agendamento confirmado com sucesso!' }) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              { "name": "Access-Control-Allow-Origin", "value": "*" },
              { "name": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
              { "name": "Access-Control-Allow-Headers", "value": "Content-Type" }
            ]
          }
        }
      },
      "id": "55555555-5555-4555-8555-555555555555",
      "name": "Responder a Cliente",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [520, 0]
    }
  ],
  "connections": {
    "Webhook - Novo Agendamento": {
      "main": [
        [{ "node": "Preparar Dados", "type": "main", "index": 0 }]
      ]
    },
    "Preparar Dados": {
      "main": [
        [{ "node": "Google Calendar - Criar Evento", "type": "main", "index": 0 }]
      ]
    },
    "Google Calendar - Criar Evento": {
      "main": [
        [{ "node": "Evolution API - Enviar WhatsApp", "type": "main", "index": 0 }]
      ]
    },
    "Evolution API - Enviar WhatsApp": {
      "main": [
        [{ "node": "Responder a Cliente", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}

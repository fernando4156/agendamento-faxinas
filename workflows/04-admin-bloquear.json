    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Valida a chave de administrador e prepara a data\nconst src = $input.first().json;\nlet b = (src && src.body !== undefined) ? src.body : src;\nif (typeof b === 'string') { try { b = JSON.parse(b); } catch (e) { b = {}; } }\nif (!b || typeof b !== 'object') b = {};\n\nconst esperado = $env.ADMIN_KEY;\nif (!esperado) { throw new Error('ADMIN_KEY nao configurada no servidor.'); }\nif (String(b.chave || '') !== String(esperado)) { throw new Error('Chave de administrador invalida.'); }\n\nconst data = String(b.data || '').substring(0, 10);\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(data)) { throw new Error('Data invalida. Envie YYYY-MM-DD.'); }\n\nreturn [{ json: { data: data, inicio: data + 'T00:00:00-03:00', fim: data + 'T23:59:00-03:00' } }];"
      },
      "id": "aa222222-2222-4222-8222-222222222222",
      "name": "Validar Chave",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-180, 0]
    },
    {
      "parameters": {
        "operation": "create",
        "calendar": {
          "__rl": true,
          "value": "fernandomateusold1@gmail.com",
          "mode": "id"
        },
        "start": "={{ $json.inicio }}",
        "end": "={{ $json.fim }}",
        "additionalFields": {
          "summary": "BLOQUEADO",
          "description": "Data bloqueada pelo painel de administrador"
        }
      },
      "id": "aa333333-3333-4333-8333-333333333333",
      "name": "Criar Bloqueio",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1,
      "position": [60, 0],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "uLcZxG74bKdnNEyr",
          "name": "Google Calendar - Faxinas"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'ok', acao: 'bloqueado', data: $('Validar Chave').first().json.data }) }}",

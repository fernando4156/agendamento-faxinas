  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "admin-bloquear",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "aa111111-1111-4111-8111-111111111111",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-420, 0],

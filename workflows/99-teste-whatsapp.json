        "jsCode": "// Fluxo de TESTE: valida somente o caminho do WhatsApp (Evolution API).\n// Nao usa Google Calendar nem qualquer outra dependencia.\n\nconst src = $input.first().json;\nlet b = (src && src.body !== undefined) ? src.body : src;\nif (typeof b === 'string') { try { b = JSON.parse(b); } catch (e) { b = {}; } }\nif (!b || typeof b !== 'object') { b = {}; }\n\nconst pad = (n) => String(n).padStart(2, '0');\nconst agora = new Date();\nconst carimbo = `${pad(agora.getDate())}/${pad(agora.getMonth() + 1)}/${agora.getFullYear()} ${pad(agora.getHours())}:${pad(agora.getMinutes())}`;\n\n// MODO TESTE - numero do Fernando. Em producao, trocar pelo da mae.\nconst destino = b.destino || '5521970762629';\n\nconst texto = b.texto || `🧪 Teste do sistema de agendamento de faxinas\\n✅ Conexao com a Evolution API funcionando!\\n🕒 Enviado em: ${carimbo}`;\n\nreturn [{ json: { destino, texto } }];"
      },
      "id": "c2222222-2222-4222-8222-222222222222",
      "name": "Montar Mensagem de Teste",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://evolution-api:8080/message/sendText/faxinas",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.destino, text: $json.texto }) }}",
        "options": {}
      },
      "id": "c3333333-3333-4333-8333-333333333333",
      "name": "Evolution API - Enviar Teste",

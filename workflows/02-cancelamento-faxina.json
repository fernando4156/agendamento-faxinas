          "value": "SEU_CALENDAR_ID@group.calendar.google.com",
          "mode": "id"
        },
        "returnAll": true,
        "options": {
          "timeMin": "={{ $json.inicioISO }}",
          "timeMax": "={{ $json.fimISO }}",
          "singleEvents": true,
          "orderBy": "startTime"
        }

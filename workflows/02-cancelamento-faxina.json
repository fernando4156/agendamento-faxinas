        "jsCode": "const busca = $('Preparar Busca').first().json;\nconst ev = $input.first().json;\n\nconst nome = ev.summary ? String(ev.summary).replace(/^Faxina - /i, '') : busca.nome;\nconst texto = `❌ Agendamento Cancelado\\n👤 Cliente: ${nome}\\n📆 Data: ${busca.dataBruta}\\n\\n✅ Esse dia ficou LIVRE na sua agenda!`;\n\nreturn [{ json: { texto } }];"

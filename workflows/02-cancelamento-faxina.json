        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Filtra o evento cujo titulo contem o nome da cliente\nconst nomeAlvo = $('Preparar Busca').first().json.nome.toLowerCase();\n\nconst eventos = $input.all();\nconst encontrados = eventos.filter((item) => {\n  const ev = item.json;\n  const titulo = String(ev.summary || ev.title || '').toLowerCase();\n  return titulo.includes(nomeAlvo);\n});\n\nif (encontrados.length === 0) {\n  throw new Error(`Nenhum agendamento encontrado para \"${nomeAlvo}\" nesse dia.`);\n}\n\nreturn encontrados.map((item) => ({ json: item.json }));"
      },

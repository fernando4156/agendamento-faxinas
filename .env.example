# =============================================================================
# .env.example  ->  MODELO.  Copie para ".env" e preencha com valores reais.
# O arquivo .env VERDADEIRO nunca deve ser enviado ao GitHub (ver .gitignore).
# =============================================================================

# Fuso horario usado por n8n, Postgres e Evolution API
TZ=America/Sao_Paulo

# -----------------------------------------------------------------------------
# PostgreSQL (banco unico compartilhado por evolution + n8n)
# -----------------------------------------------------------------------------
POSTGRES_USER=faxina_admin
POSTGRES_PASSWORD=troque-por-uma-senha-forte-e-unica
POSTGRES_DB=faxina_default
# Bancos extra criados automaticamente no primeiro boot (docker/init-db.sql)
EVOLUTION_DB_NAME=evolution
N8N_DB_NAME=n8n

# -----------------------------------------------------------------------------
# Evolution API (WhatsApp)
# -----------------------------------------------------------------------------
# URL publica/local da API. Ajuste para o dominio quando expor na internet.
SERVER_URL=http://localhost:8080
# Chave GLOBAL de autenticacao. Gere algo longo e aleatorio (ex.: openssl rand -hex 32).
AUTHENTICATION_API_KEY=troque-por-uma-api-key-longa-e-aleatoria
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false
LANGUAGE=pt-BR
DEL_INSTANCE=false
QRCODE_LIMIT=30
CONFIG_SESSION_PHONE_CLIENT=Agendamento Faxinas
CONFIG_SESSION_PHONE_NAME=Chrome

# Persistencia em banco
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://faxina_admin:troque-por-uma-senha-forte-e-unica@postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=evolution_faxinas
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true

# Cache (Redis)
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/1
CACHE_REDIS_PREFIX_KEY=evolution_faxinas
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# Integracoes opcionais desligadas (nao usamos)
RABBITMQ_ENABLED=false
SQS_ENABLED=false
WEBSOCKET_ENABLED=false
S3_ENABLED=false
OPENAI_ENABLED=false
DIFY_ENABLED=false
TYPEBOT_ENABLED=false
CHATWOOT_ENABLED=false

# Webhooks globais da Evolution (usaremos webhook por instancia/evento)
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_URL=

# -----------------------------------------------------------------------------
# n8n
# -----------------------------------------------------------------------------
N8N_HOST=localhost
# URL base que o n8n usa para montar os links de webhook.
# Em producao, troque por https://seu-dominio.com/
N8N_WEBHOOK_URL=http://localhost:5678/
# Cifra as credenciais salvas no n8n. Gere algo aleatorio e guarde com cuidado.
N8N_ENCRYPTION_KEY=troque-por-uma-chave-aleatoria-de-32-caracteres

# -----------------------------------------------------------------------------
# Regras de negocio / integracoes
# -----------------------------------------------------------------------------
# Destino das notificacoes, formato internacional SOMENTE digitos (ex.: 5521970762629)
# TESTE: numero do Fernando (21970762629 -> 5521970762629).
# Ao passar para producao, troque pelo numero da sua mae.
MOM_WHATSAPP_NUMBER=5521970762629
# Nome da instancia na Evolution API (criada no Manager)
EVOLUTION_INSTANCE_NAME=faxinas
# ID do Google Calendar onde os agendamentos serao gravados
GOOGLE_CALENDAR_ID=seu-calendar-id@group.calendar.google.com
